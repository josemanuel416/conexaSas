# Configuración del servidor
PORT=3000

# Modo de prueba (true = simula firma y envío, false = usa certificado real)
TEST_MODE=false

# Enviar a DIAN real (false = simula respuesta, true = envía a DIAN)
# Útil para probar con certificado real sin enviar a DIAN
SEND_TO_DIAN=false

# Certificado digital DIAN
CERT_PASS=tu_contraseña_del_certificado_aqui

# Software registrado en DIAN
SOFTWARE_ID=tu_software_id_aqui
CLAVE_TECNICA=tu_clave_tecnica_aqui

# Ambiente DIAN (habilitacion o produccion)
DIAN_ENV=habilitacion

# URLs de servicios DIAN
DIAN_SOAP_URL_HAB=https://vpfe-hab.dian.gov.co/WcfDianCustomerServices.svc?wsdl
DIAN_SOAP_URL_PROD=https://vpfe.dian.gov.co/WcfDianCustomerServices.svc?wsdl
