PORT=3500
NODE_ENV=development

# Zona horaria operativa (Bogotá / Lima / Quito — UTC−5)
TZ=America/Bogota

# PostgreSQL — desarrollo diario: instancia LOCAL (pgAdmin / instalador Windows)
# Ajusta usuario y contraseña según tu PostgreSQL local:
DATABASE_URL=postgresql://postgres:TU_PASSWORD@localhost:5432/Conexa

# Fin de jornada (Docker): usar temporalmente
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/Conexa

# JWT
JWT_SECRET=cambiar-este-secreto-en-produccion
JWT_EXPIRES_IN=8h

# Admin inicial (se crea en la primera migración)
ADMIN_EMAIL=admin@conexa.com
ADMIN_PASSWORD=Admin123!
ADMIN_NAME=Administrador Conexa

# Compañía operativa ConexaSoft (login tenant en /login, no panel /admin)
CONEXASOFT_SLUG=conexasoft
CONEXASOFT_ADMIN_EMAIL=admin@conexasoft.com
CONEXASOFT_ADMIN_PASSWORD=Admin123!
CONEXASOFT_ADMIN_NAME=Administrador ConexaSoft

# CORS - URL del frontend
CORS_ORIGIN=http://localhost:9500,http://localhost:9501

# ServerFEpos — firma y envío DIAN
FEPOS_URL=http://localhost:3010
FEPOS_CERT_ROOT=../ServerFEpos/cert/companies
CERT_STORAGE_PATH=storage/dian-certs
